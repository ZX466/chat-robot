!/.workflows/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# 机密
.env
config.yaml
*.key
*.pem

# 构建产物
dist/
build/
node_modules/

# Unity（client 工程）
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
MemoryCaptures/
*.csproj
*.sln
*.vcxproj
*.vcxproj.filters
.vs/
