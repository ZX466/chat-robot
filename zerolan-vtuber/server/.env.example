# zerolan-vtuber server 环境变量示例（复制为 .env 后填写真实值）
# 密钥绝不提交：.env 已在 .gitignore

# LLM（config.yaml 优先，环境变量兜底）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# VOLCENGINE_API_KEY=
# ARK_API_KEY=

# Web search（§5，Tavily 主，失败自动降级 ddgs）
# TAVILY_API_KEY=
# ddgs 搜索引擎代理（国内网络直连 google/duckduckgo/brave 等不可达时必填，走本地代理端口）
# DDGS_PROXY=http://127.0.0.1:7897